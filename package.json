{
  "name": "one-more-move",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile-first deterministic circuit puzzle.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pwa": "node scripts/build.mjs",
    "build:native": "node scripts/build.mjs",
    "check": "node --check game.js && node tests/static-check.mjs && node tests/browser-smoke.mjs && npm audit --omit=dev",
    "test:browser": "node tests/browser-smoke.mjs",
    "cap:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2"
  }
}
